# ===================================
# SERVER CONFIGURATION
# ===================================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ===================================
# DATABASE
# ===================================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/multischool_idcard?retryWrites=true&w=majority

# ===================================
# JWT SECRETS
# ===================================
JWT_ACCESS_SECRET=your_access_token_secret_min_32_chars_long
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_EMAIL_VERIFY_SECRET=your_email_verify_secret_min_32_chars
JWT_EMAIL_VERIFY_EXPIRY=24h
JWT_PASSWORD_RESET_SECRET=your_password_reset_secret_min_32_chars
JWT_PASSWORD_RESET_EXPIRY=1h

# ===================================
# GOOGLE OAUTH 2.0
# ===================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ===================================
# EMAIL (SMTP)
# ===================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM_NAME=Multischool ID Card System
EMAIL_FROM_ADDRESS=noreply@multischool-idcard.com

# ===================================
# FRONTEND URL (for email links)
# ===================================
FRONTEND_URL=http://localhost:3000

# ===================================
# RATE LIMITING
# ===================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ===================================
# CORS
# ===================================
CORS_ORIGIN=http://localhost:3000

# ===================================
# LOGGING
# ===================================
LOG_LEVEL=debug
LOG_DIR=logs
